  "version": "0.2.0",
  "configurations": [
    {
      "name": "e2e",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceRoot}/node_modules/protractor/bin/protractor",
      "stopOnEntry": false,
      "args": [
        "${workspaceRoot}/e2e/protractor.conf.js",
        "--params.dev", "dev",
        "--visible", "visible"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "e2e:ste",
      "type": "pwa-node",

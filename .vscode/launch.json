        "${workspaceRoot}/e2e/protractor.conf.js",
        "--visible", "visible",
        "--baseUrl", "http://steccm04wrpxy01.cpp.nonlive/prosecutor/"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "e2e:sit",
      "type": "pwa-node",

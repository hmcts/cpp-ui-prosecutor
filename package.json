{
  "name": "prosecutor",
  "version": "0.0.145-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "format": "pretty-quick --staged",
    "start": "ng serve",
    "build": "ng build",
    "build:staging": "ng build --configuration staging",
    "build:prod": "ng build --configuration production",
    "lint": "ng lint",
    "lint:fix": "ng run prosecutor:fix-lint",
    "ci:lint": "mkdirp ./build/lint && ng run prosecutor:ci-lint 1> ./build/lint/tslint-checkstyle-result.xml",
    "test": "ng test",
    "ci:test": "ng run prosecutor:ci-test",
    "ci:prime": "echo no-priming-needed",
    "nsp": "nsp",
    "ci:nsp": "mkdirp ./build/dependency-check && nsp check --reporter owasp 1> ./build/dependency-check/dependency-check-report.xml || rm ./build/dependency-check/dependency-check-report.xml || true",
    "deploy": "ng build --deploy-url /prosecutor/ --outputPath=$VAGRANT_DIR/ui/ui-prosecutor/prosecutor",
    "start:vagrant": "ng build --deploy-url /prosecutor/ --outputPath=$VAGRANT_DIR/ui/ui-prosecutor/prosecutor --watch",
    "e2e": "protractor e2e/protractor.conf.js --params.dev dev --visible",
    "e2e:remote": "protractor e2e/protractor.conf.js --visible",
    "e2e:vagrant": "protractor e2e/protractor.conf.js --baseUrl http://localhost:7080 --params.apiUrl http://localhost:8080",
    "e2e:ci": "webdriver-manager update && protractor e2e/protractor.conf.js",
    "update-webdriver": "webdriver-manager update",
    "case": "ts-node tools/cases.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.15",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.15",
    "@angular/compiler": "^19.2.15",
    "@angular/core": "^19.2.15",
    "@angular/forms": "^19.2.15",
    "@angular/platform-browser": "^19.2.15",
    "@angular/platform-browser-dynamic": "^19.2.15",
    "@angular/router": "^19.2.15",
    "@cpp/application": "^19.0.6",
    "@cpp/core": "^19.0.1",
    "@cpp/pdk": "^19.0.6",
    "@cpp/reference-data": "^19.0.1",
    "@cpp/users-groups": "^19.0.1",
    "@kolkov/angular-editor": "^2.1.0",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/router-store": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "clean-deep": "^3.4.0",
    "core-js": "^3.29.1",
    "file-saver": "^2.0.5",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "rxjs": "^7.8.1",
    "shallow-render": "^19.0.0",
    "tslib": "^2.3.0",
    "uuid": "^3.4.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^19.0.1",
    "@angular-devkit/build-angular": "^19.2.19",
    "@angular-devkit/core": "^19.2.19",
    "@angular-devkit/schematics": "^19.2.19",
    "@angular-eslint/builder": "^19.8.1",
    "@angular-eslint/eslint-plugin": "^19.8.1",
    "@angular-eslint/eslint-plugin-template": "^19.8.1",
    "@angular-eslint/schematics": "^19.8.1",
    "@angular-eslint/template-parser": "^19.8.1",
    "@angular/cli": "^19.2.19",
    "@angular/compiler-cli": "^19.2.15",
    "@angular/language-service": "^19.2.15",
    "@cpp/testing": "^19.0.1",
    "@ng-select/ng-select": "^14.9.0",
    "@ngrx/store-devtools": "^19.2.1",
    "@types/archiver": "^2.1.2",
    "@types/file-saver": "^2.0.1",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/jest": "^29.4.0",
    "@types/lodash-es": "^4.17.9",
    "@types/node": "^18.0.0",
    "@types/yargs": "^12.0.9",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@typescript-eslint/utils": "^8.44.1",
    "archiver": "^3.0.0",
    "babel-preset-env": "^1.7.0",
    "eslint": "^9.39.0",
    "eslint-formatter-checkstyle": "^9.0.1",
    "fs-extra": "^7.0.1",
    "husky": "^1.3.1",
    "jasmine-core": "~3.6.0",
    "jasmine-marbles": "^0.9.2",
    "jasmine-spec-reporter": "^2.3.0",
    "jest": "^29.7.0",
    "jest-cli": "^28.1.3",
    "jest-environment-jsdom": "^29.7.0",
    "jest-jasmine2": "^29.7.0",
    "jest-junit": "^15.0.0",
    "mkdirp": "^0.5.1",
    "npm-run-all": "^4.1.5",
    "pa11y-ci": "^3.0.1",
    "prettier": "^1.16.4",
    "pretty-quick": "^1.10.0",
    "protractor": "~7.0.0",
    "protractor-screenshoter-plugin": "^0.10.1",
    "screenshoter-report-analyzer": "^0.6.0",
    "ts-node": "~7.0.0",
    "typescript": "~5.8.3",
    "yargs": "^13.2.1"
  },
  "babel": {
    "presets": [
      "env"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsc --noEmit && run-s format lint:fix"
    }
  }
}

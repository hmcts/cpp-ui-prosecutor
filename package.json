{
  "name": "prosecutor",
  "version": "0.0.145-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "format": "pretty-quick --staged",
    "start": "ng serve",
    "build": "ng build",
    "build:staging": "ng build --configuration staging",
    "build:prod": "ng build --configuration production",
    "lint": "ng lint",
    "lint:fix": "ng run prosecutor:fix-lint",
    "ci:lint": "mkdirp ./build/lint && ng run prosecutor:ci-lint 1> ./build/lint/tslint-checkstyle-result.xml",
    "test": "ng test",
    "ci:test": "ng run prosecutor:ci-test",
    "ci:prime": "echo no-priming-needed",
    "nsp": "nsp",
    "ci:nsp": "mkdirp ./build/dependency-check && nsp check --reporter owasp 1> ./build/dependency-check/dependency-check-report.xml || rm ./build/dependency-check/dependency-check-report.xml || true",
    "sonar:scanner": "sonar-scanner -Dsonar.projectVersion=${version}",
    "sonar:local_verify": "SONAR_SCANNER_OPTS=\"-Dhttp.nonProxyHosts=localhost|127.0.0.1\" npm run-script sonar:scanner -- -Dsonar.analysis.mode=preview -Dsonar.host.url=http://10.124.22.71:9000 -Dsonar.branch=master",
    "deploy": "ng build --deploy-url /prosecutor/ --outputPath=$VAGRANT_DIR/ui/ui-prosecutor/prosecutor",
    "start:vagrant": "ng build --deploy-url /prosecutor/ --outputPath=$VAGRANT_DIR/ui/ui-prosecutor/prosecutor --watch",
    "e2e": "protractor e2e/protractor.conf.js --params.dev dev --visible",
    "e2e:remote": "protractor e2e/protractor.conf.js --visible",
    "e2e:vagrant": "protractor e2e/protractor.conf.js --baseUrl http://localhost:7080 --params.apiUrl http://localhost:8080",
    "e2e:ci": "webdriver-manager update && protractor e2e/protractor.conf.js",
    "update-webdriver": "webdriver-manager update",
    "case": "ts-node tools/cases.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^15.2.10",
    "@angular/cdk": "^15.2.9",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/router": "^15.2.10",
    "@cpp/application": "^15.0.3",
    "@cpp/core": "^15.0.1",
    "@cpp/pdk": "^15.0.3",
    "@cpp/users-groups": "^15.0.1",
    "@cpp/reference-data": "^15.0.1",
    "@kolkov/angular-editor": "^2.1.0",
    "@ngrx/effects": "15.4.0",
    "@ngrx/router-store": "15.4.0",
    "@ngrx/store": "15.4.0",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "clean-deep": "^3.4.0",
    "core-js": "^3.29.1",
    "file-saver": "^2.0.5",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "rxjs": "~6.6.7",
    "tslib": "^2.0.0",
    "uuid": "^3.4.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-builders/jest": "^16.0.1",
    "@angular-devkit/build-angular": "^15.2.10",
    "@angular-devkit/schematics": "^15.2.10",
    "@angular-eslint/builder": "15.2.1",
    "@angular-eslint/eslint-plugin": "15.2.1",
    "@angular-eslint/eslint-plugin-template": "15.2.1",
    "@angular-eslint/schematics": "15.2.1",
    "@angular-eslint/template-parser": "15.2.1",
    "@angular/cli": "^15.2.10",
    "@angular/compiler-cli": "^15.2.10",
    "@angular/language-service": "^15.2.10",
    "@cpp/ui.config": "^2.0.0",
    "@cpp/ui.priming": "2.0.2",
    "@cpp/ui.test-utils": "2.1.5",
    "@ngrx/store-devtools": "15.4.0",
    "@types/archiver": "^2.1.2",
    "@types/file-saver": "^2.0.1",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/jest": "^22.2.3",
    "@types/lodash-es": "^4.17.9",
    "@types/node": "^12.11.1",
    "@types/yargs": "^12.0.9",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "@typescript-eslint/parser": "^5.43.0",
    "archiver": "^3.0.0",
    "babel-preset-env": "^1.7.0",
    "eslint": "^8.28.0",
    "fs-extra": "^7.0.1",
    "husky": "^1.3.1",
    "jasmine-core": "~3.6.0",
    "jasmine-marbles": "~0.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "jest": "^29.7.0",
    "jest-cli": "^28.1.3",
    "jest-environment-jsdom": "^28.1.3",
    "jest-jasmine2": "^27.5.1",
    "jest-junit": "^15.0.0",
    "mkdirp": "^0.5.1",
    "ngrx-store-logger": "^0.2.2",
    "npm-run-all": "^4.1.5",
    "pa11y-ci": "^3.0.1",
    "prettier": "^1.16.4",
    "pretty-quick": "^1.10.0",
    "protractor": "~7.0.0",
    "protractor-screenshoter-plugin": "^0.10.1",
    "screenshoter-report-analyzer": "^0.6.0",
    "shallow-render": "^14.2.4",
    "sonar-scanner": "^3.1.0",
    "ts-node": "~7.0.0",
    "tslint-sonarts": "^1.9.0",
    "typescript": "~4.9.5",
    "yargs": "^13.2.1"
  },
  "babel": {
    "presets": [
      "env"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsc --noEmit && run-s format lint:fix"
    }
  }
}

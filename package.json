{
  "name": "prosecutor",
  "version": "0.0.145-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "format": "pretty-quick --staged",
    "start": "ng serve --base-href=\"/prosecutor/\" --port 4750",
    "build": "ng build --base-href=\"/prosecutor/\" --deploy-url /prosecutor/",
    "ci:build": "ng build --base-href=\"/prosecutor/\"",
    "build:prod": "ng build --base-href=\"/prosecutor/\"",
    "lint": "ng lint --type-check --format verbose",
    "lint:fix": "ng lint --type-check --fix=true --format verbose",
    "ci:lint": "mkdirp ./build/lint && ng lint --type-check --no-fix --force --format checkstyle 1> ./build/lint/tslint-checkstyle-result.xml",
    "test": "ng test --watch --coverage",
    "ci:test": "ng test --ci --coverage --no-cache",
    "ci:build:prod": "npm run-script ci:build -- --configuration=production",
    "ci:build:staging": "npm run-script ci:build -- --configuration=staging",
    "ci:build:test": "npm run-script ci:build:staging",
    "ci:prime": "echo no-priming-needed",
    "nsp": "nsp",
    "ci:nsp": "mkdirp ./build/dependency-check && nsp check --reporter owasp 1> ./build/dependency-check/dependency-check-report.xml || rm ./build/dependency-check/dependency-check-report.xml || true",
    "sonar:scanner": "sonar-scanner -Dsonar.projectVersion=${version}",
    "sonar:local_verify": "SONAR_SCANNER_OPTS=\"-Dhttp.nonProxyHosts=localhost|127.0.0.1\" npm run-script sonar:scanner -- -Dsonar.analysis.mode=preview -Dsonar.host.url=http://10.124.22.71:9000 -Dsonar.branch=master",
    "deploy": "ng build --base-href=\"/prosecutor/\" --deploy-url /prosecutor/ --outputPath=$VAGRANT_DIR/ui/ui-prosecutor/prosecutor",
    "start:vagrant": "ng build --base-href=\"/prosecutor/\" --deploy-url /prosecutor/ --outputPath=$VAGRANT_DIR/ui/ui-prosecutor/prosecutor --watch",
    "e2e": "protractor e2e/protractor.conf.js --params.dev dev --visible",
    "e2e:remote": "protractor e2e/protractor.conf.js --visible",
    "e2e:vagrant": "protractor e2e/protractor.conf.js --baseUrl http://localhost:7080 --params.apiUrl http://localhost:8080",
    "e2e:ci": "webdriver-manager update && protractor e2e/protractor.conf.js",
    "update-webdriver": "webdriver-manager update",
    "case": "ts-node tools/cases.ts",
    "test:accessibility": "pa11y-ci --reporter json > errors.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^7.2.6",
    "@angular/cdk": "^7.3.7",
    "@angular/common": "^7.2.6",
    "@angular/compiler": "^7.2.6",
    "@angular/core": "^7.2.6",
    "@angular/forms": "^7.2.6",
    "@angular/platform-browser": "^7.2.6",
    "@angular/platform-browser-dynamic": "^7.2.6",
    "@angular/router": "^7.2.6",
    "@cpp/application": "7.10.8",
    "@cpp/core": "7.9.24",
    "@cpp/pdk": "7.10.8",
    "@cpp/users-groups": "7.9.6",
    "@kolkov/angular-editor": "^1.2.0",
    "@ngrx/effects": "8.0.1",
    "@ngrx/router-store": "8.0.1",
    "@ngrx/store": "8.0.1",
    "@ngx-translate/core": "^11.0.1",
    "@ngx-translate/http-loader": "^4.0.0",
    "core-js": "^2.5.4",
    "file-saver": "^2.0.5",
    "moment": "^2.24.0",
    "rxjs": "~6.3.3",
    "tslib": "^1.10.0",
    "uuid": "^3.3.2",
    "zone.js": "^0.8.29"
  },
  "devDependencies": {
    "@angular-builders/jest": "^7.4.1",
    "@angular-devkit/build-angular": "~0.13.0",
    "@angular/cli": "~7.3.0",
    "@angular/compiler-cli": "^7.2.6",
    "@angular/language-service": "^7.2.6",
    "@cpp/ui.config": "^2.0.0",
    "@cpp/ui.priming": "2.0.2",
    "@cpp/ui.test-utils": "2.1.5",
    "@ngrx/store-devtools": "8.0.1",
    "@types/archiver": "^2.1.2",
    "@types/file-saver": "^2.0.1",
    "@types/jasmine": "~2.8.8",
    "@types/jasminewd2": "~2.0.3",
    "@types/jest": "^22.2.3",
    "@types/node": "~8.9.4",
    "@types/yargs": "^12.0.9",
    "archiver": "^3.0.0",
    "babel-preset-env": "^1.7.0",
    "codelyzer": "~4.5.0",
    "fs-extra": "^7.0.1",
    "husky": "^1.3.1",
    "jasmine-core": "~2.99.1",
    "jasmine-marbles": "^0.4.1",
    "jasmine-spec-reporter": "~4.2.1",
    "jest": "^24.1.0",
    "jest-junit": "^6.2.1",
    "mkdirp": "^0.5.1",
    "ngrx-store-logger": "^0.2.2",
    "npm-run-all": "^4.1.5",
    "pa11y-ci": "^3.0.1",
    "prettier": "^1.16.4",
    "pretty-quick": "^1.10.0",
    "protractor": "5.4.0",
    "sonar-scanner": "^3.1.0",
    "ts-node": "~7.0.0",
    "tslint": "~5.11.0",
    "tslint-sonarts": "^1.9.0",
    "typescript": "~3.2.2",
    "yargs": "^13.2.1",
    "protractor-screenshoter-plugin": "^0.10.1",
    "screenshoter-report-analyzer": "^0.6.0"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/src/app/devtools",
      ".module.ts$",
      ".index.ts$",
      ".routes.ts$",
      ".*mock.ts$"
    ],
    "coverageDirectory": "<rootDir>/build/coverage/jest",
    "coverageReporters": [
      "text",
      "cobertura",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/app/**/*.{ts,js}",
      "!src/app/*.{ts,js}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "babel": {
    "presets": [
      "env"
    ]
  },
  "husky": {
    "hooks": {
      "pre-push": "tsc --noEmit && run-s format lint"
    }
  }
}

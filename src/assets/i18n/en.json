      "opens_new_window": "opens in new window",
      "nav": {
        "title": "Contents",
        "statementLink": "Accessibility statement for ATCM",
        "whatToDoLink": "What to do if you can't access parts of this website",
        "enforcementProcedureLink": "Enforcement procedure",
        "technicalInformationLink": "Technical information about this website's accessibility",
        "whatWereDoingLink": "What we're doing to improve accessibility"
      },
      "title": "Accessibility statement for ATCM",
      "statement": {
        "paragraph1": "The ATCM website is run by the Ministry of Justice Crime Reform Programme. We want as many people as possible to be able to use it. For example, that means you should be able to:",
        "bullets": {
          "font_size": "change font size",
          "zoom_up": "zoom in up to 300% without the text spilling off the screen",
          "navigate_keyboard": "navigate most of the website using just a keyboard",
          "navigate_speech": "navigate most of the website using speech recognition software",
          "listen_screen_reader": "listen to most of the website using a screen reader (including the most recent versions of JAWS, NVDA and VoiceOver)"
        },
        "paragraph2": "We've also made the website text as simple as possible to understand.",
        "paragraph3": "has advice on making your device easier to use if you have a disability."
      },
      "what_to_do": {
        "title": "What to do if you can't access parts of this website",
        "email": "email",
        "paragraph1": "We're always looking to improve the accessibility of this website. If you find any problems that aren't listed on this page or think we're not meeting accessibility requirements, contact:",
        "paragraph1b": "You will receive a reply within 10 working days."
      },
      "enforcement": {
        "title": "Enforcement procedure",
        "paragraph1": "The Equality and Human Rights Commission (EHRC) is responsible for enforcing the Public Sector Bodies (Websites and Mobile Applications) (No. 2) Accessibility Regulations 2018 (the 'accessibility regulations'). If you're not happy with how we respond to your complaint, contact the",
        "link": "Equality Advisory and Support Service (EASS)."
      },
      "technical": {
        "title": "Technical information about this website's accessibility",
        "paragraph1": "The Ministry of Justice Crime Reform Programme is committed to making its website accessible, in accordance with the Public Sector Bodies (Websites and Mobile Applications) (No. 2) Accessibility Regulations 2018.",
        "paragraph2": "We are currently conducting an internal accessibility audit of a representative sample of our screens in order to identify any accessibility issues. We plan to fix any accessibility issues it identifies up to the WCAG 2.1 AA standards apart from any which would be a disproportionate burden."
      },
      "what-were-doing": {
        "title": "What we're doing to improve accessibility",
        "paragraph1": "We are currently conducting an internal accessibility audit of a representative sample of our screens in order to identify any other accessibility issues.",
        "paragraph2": "After this audit is complete we plan to review and update our internal platform development kit if necessary. This contains templates of common patterns and components which are then used consistently across the system. Ensuring these patterns and components are WCAG 2.1 AA compliant will make all instances of them across our systems compliant.",
        "paragraph3": "We will release front end development resources to fix other identified accessibility issues. We plan to do all this before our screens are released to their full user base.",
        "paragraph4": "We will also consider conducting external accessibility audits by the Digital Accessibility Centre (DAC) following subsequent major new code releases where this is appropriate."
      }
    }
  },

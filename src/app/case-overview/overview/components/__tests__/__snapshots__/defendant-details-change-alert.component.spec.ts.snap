// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`DefendantDetailsChangeAlertComponent -> Legal entity defendant should display red banner with address changed 1`] = `
<defendant-details-change-alert-test
  legalEntityDetails={[Function Object]}
>
  <defendant-details-change-alert>
    <pdk-alert
      aria-describedby="personal-details-updated-alert"
      class="govuk-!-margin-top-1 govuk-!-margin-bottom-1"
      icon="true"
      pdk-margin-vertical="1"
      type="warning"
    >
      <div
        class="pdk-alert pdk-alert--warning"
        role="alert"
      >
        <div
          class="pdk-alert__container"
        >
          <i
            aria-hidden="true"
            class="pdk-alert__icon pdk-alert__icon--alert"
            role="presentation"
          />
          <div
            class="pdk-alert__message"
          >
            <div>
               The following defendant details have been updated: 
              <div>
                Address details
              </div>
              <div>
                Name
              </div>
            </div>
          </div>
        </div>
      </div>
    </pdk-alert>
  </defendant-details-change-alert>
</defendant-details-change-alert-test>
`;


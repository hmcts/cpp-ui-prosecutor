exports[`FinancialOffenceDecisionComponent should compile correctly with discharge offence decision with absolute discharge 1`] = `
<financial-offence-decision-test
  offenceDecision={[Function Object]}
>
  <financial-offence-decision
    ng-reflect-offence-decision="[object Object]"
  >
    
    <div>
      Discharged Absolutely
    </div>
    
    
    
    <div>
      No compensation ordered because some reason
    </div>
    
    <div>
       Defendant's guilty plea Taken into account when imposing sentence 
    </div>
  </financial-offence-decision>
</financial-offence-decision-test>
`;


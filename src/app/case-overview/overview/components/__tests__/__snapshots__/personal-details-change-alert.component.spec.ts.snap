// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`PeronalDetailsChangeAlertComponent should display red banner with address changed 1`] = `
<personal-details-change-alert-test
  personalDetails={[Function Object]}
>
  <personal-details-change-alert
    ng-reflect-personal-details="[object Object]"
  >
    
    <pdk-alert
      aria-describedby="personal-details-updated-alert"
      class="govuk-!-margin-top-1 govuk-!-margin-bottom-1"
      icon="true"
      ng-reflect-icon="true"
      ng-reflect-type="warning"
      ng-reflect-vertical="1"
      pdk-margin-vertical="1"
      type="warning"
    >
      <div
        class="pdk-alert pdk-alert--warning"
        role="alert"
      >
        <div
          class="pdk-alert__container"
        >
          
          <i
            aria-hidden="true"
            class="pdk-alert__icon pdk-alert__icon--alert"
            role="presentation"
          />
          <div
            class="pdk-alert__message"
          >
            <div>
               The following defendant details have been updated: 
              
              
              <div>
                Address details
              </div>
              
              <div>
                Name
              </div>
            </div>
          </div>
        </div>
      </div>
    </pdk-alert>
  </personal-details-change-alert>
</personal-details-change-alert-test>
`;


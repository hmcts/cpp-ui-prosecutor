             Sum to be recovered £100.23. Reason: Compensation ordered 
          </pdk-grid>
        </pdk-grid>
        <pdk-grid
          class="govuk-!-padding-top-1 govuk-!-padding-bottom-1 govuk-grid-row"
          container=""
          pdk-padding-vertical="1"
        >
          <pdk-grid
            class="govuk-grid-column-one-third"
            one-third=""
          >
            <b>
              Reserve terms(if deductions fail)
            </b>
          </pdk-grid>
          <pdk-grid
            class="govuk-grid-column-two-thirds"
            two-thirds=""
          >
             Outstanding balance to be paid as a Lump sum within 10 days 
          </pdk-grid>
        </pdk-grid>
        <pdk-grid
          class="govuk-!-padding-top-1 govuk-!-padding-bottom-1 govuk-grid-row"
          container=""
          pdk-padding-vertical="1"
        >
          <pdk-grid
            class="govuk-grid-column-one-third"
            one-third=""
          >
            <b>
              Total to pay
            </b>
          </pdk-grid>
          <pdk-grid
            class="govuk-grid-column-two-thirds"
            two-thirds=""
          >
             £100.23 

exports[`PaymentAndCollectionComponent should compile correctly for payment terms with deduct from benefits with lump sum and within days > 0 1`] = `
<payment-and-collection-test
  caseDecision={[Function Object]}
>
  <payment-and-collection
    ng-reflect-case-decision="[object Object]"
  >
    <div
      class="govuk-!-margin-left-2"
      ng-reflect-left="2"
      pdk-margin-left="2"
    >
      <div
        class="govuk-!-margin-bottom-3"
        ng-reflect-bottom="3"
        pdk-margin-bottom="3"
      >
        <b
          class="govuk-heading-m"
          ng-reflect-type="heading-medium"
          pdk-typography="heading-medium"
        >
          Payment and collection
        </b>
      </div>
      <div>
        <pdk-grid
          class="govuk-!-padding-top-1 govuk-!-padding-bottom-1"
          container=""
          ng-reflect-container=""
          ng-reflect-vertical="1"
          pdk-padding-vertical="1"
        >
          <div
            class="govuk-grid-row"
          >
            <pdk-grid
              ng-reflect-one-third=""
              one-third=""
            >
              <div
                class="govuk-grid-column-one-third"
              >
                
                <b>
                  Collection order made
                </b>
                
              </div>
            </pdk-grid>
            <pdk-grid
              ng-reflect-two-thirds=""
              two-thirds=""
            >
              <div
                class="govuk-grid-column-two-thirds"
              >
                 Deduct from benefits. 
              </div>
            </pdk-grid>
          </div>
        </pdk-grid>
        <pdk-grid
          class="govuk-!-padding-top-1 govuk-!-padding-bottom-1"
          container=""
          ng-reflect-container=""
          ng-reflect-vertical="1"
          pdk-padding-vertical="1"
        >
          <div
            class="govuk-grid-row"
          >
            <pdk-grid
              ng-reflect-one-third=""
              one-third=""
            >
              <div
                class="govuk-grid-column-one-third"
              >
                
                
                <div>
                  <b>
                    Application made for benefit deductions 
                  </b>
                </div>
                
              </div>
            </pdk-grid>
            <pdk-grid
              ng-reflect-two-thirds=""
              two-thirds=""
            >
              <div
                class="govuk-grid-column-two-thirds"
              >
                 Sum to be recovered £100.23. Reason: Compensation ordered 
              </div>
            </pdk-grid>
          </div>
        </pdk-grid>
        <pdk-grid
          class="govuk-!-padding-top-1 govuk-!-padding-bottom-1"
          container=""
          ng-reflect-container=""
          ng-reflect-vertical="1"
          pdk-padding-vertical="1"
        >
          <div
            class="govuk-grid-row"
          >
            <pdk-grid
              ng-reflect-one-third=""
              one-third=""
            >
              <div
                class="govuk-grid-column-one-third"
              >
                <b>
                  Reserve terms(if deductions fail)
                </b>
              </div>
            </pdk-grid>
            <pdk-grid
              ng-reflect-two-thirds=""
              two-thirds=""
            >
              <div
                class="govuk-grid-column-two-thirds"
              >
                 Outstanding balance to be paid as a Lump sum within 10 days 
              </div>
            </pdk-grid>
          </div>
        </pdk-grid>
        <pdk-grid
          class="govuk-!-padding-top-1 govuk-!-padding-bottom-1"
          container=""
          ng-reflect-container=""
          ng-reflect-vertical="1"
          pdk-padding-vertical="1"
        >
          <div
            class="govuk-grid-row"
          >
            <pdk-grid
              ng-reflect-one-third=""
              one-third=""
            >
              <div
                class="govuk-grid-column-one-third"
              >
                <b>
                  Total to pay
                </b>
              </div>
            </pdk-grid>
            <pdk-grid
              ng-reflect-two-thirds=""
              two-thirds=""
            >
              <div
                class="govuk-grid-column-two-thirds"
              >
                 £100.23 
              </div>
            </pdk-grid>
          </div>
        </pdk-grid>
      </div>
    </div>
  </payment-and-collection>
</payment-and-collection-test>
`;


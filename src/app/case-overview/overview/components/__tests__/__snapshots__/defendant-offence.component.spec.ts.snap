        _ngcontent-c0=""
        class="pdk-foldable"
      >
        <span
          _ngcontent-c0=""
          aria-expanded="false"
          class="pdk-foldable__content"
          id="pdk-foldable-text-1"
        >
           On 02/07/2015 At threadneedle street EC2 Being a passenger on a Public service Vehicle operated on .. 
        </span>
        
      </div>
    </pdk-foldable-text>
    <p
      class="govuk-!-margin-top-4 govuk-!-margin-bottom-4 govuk-body-s"

exports[`DefendantOffenceComponent should compile correctly with the offence is pending withdrawal 1`] = `
<defendant-offence-test
  kase={[Function Object]}
  offence={[Function Object]}
>
  <defendant-offence
    ng-reflect-kase="[object Object]"
    ng-reflect-offence="[object Object]"
  >
    <h2
      class="govuk-heading-l"
      ng-reflect-type="heading-large"
      pdk-typography="heading-large"
    >
       Offence 
      
    </h2>
    <defendant-offence-warnings
      ng-reflect-offence="[object Object]"
    >
       {
    "id": "offenceId2",
    "offenceCode": "CA03013",
    "title": "offence title 2",
    "legislation": "legislation 1",
    "offenceSequenceNumber": 2,
    "wording": "On 02/07/2015 At thread needle street EC2 Being a passenger on a Public service Vehicle operated on behalf of London Bus Services Limited being used for the carriage of passengers at separate fares where the vehicle was being operated by a Driver without a Conductor did not as directed by the Driver an Inspector or a Notice displayed on the vehicle pay the fare for the journey in accordance with the direction ",
    "cjsCode": "CA03013",
    "sequenceNumber": 1,
    "startDate": "2019-01-15",
    "chargeDate": "2019-01-27",
    "compensation": 23,
    "plea": "NOT_GUILTY",
    "pleaMethod": "POSTAL",
    "pleaDate": "2019-02-27T15:32:20.593Z",
    "pendingWithdrawal": true,
    "prosecutionFacts": "An incident took place at GREEN PARK station whereby you were spoken to by a member of London Underground staff regarding your train journey and the associated fare.The facts of this incidents are now being considered and I must advise you that legal proceedings may be initiated against you regarding this matter in accordance with the LU prosecution policy"
  } 
    </defendant-offence-warnings>
    <h3
      class="govuk-heading-m"
      ng-reflect-type="heading-medium"
      pdk-typography="heading-medium"
    >
      offence title 2
    </h3>
    <pdk-foldable-text
      _nghost-a-c8=""
      class="govuk-body-m"
      ng-reflect-type="body-medium"
      pdk-typography="body-medium"
    >
      <div
        _ngcontent-a-c8=""
        class="pdk-foldable"
      >
        <span
          _ngcontent-a-c8=""
          class="pdk-foldable__content"
          id="pdk-foldable-text-5"
        >
           On 02/07/2015 At thread needle street EC2 Being a passenger on a Public service Vehicle operated on behalf of London Bus Services Limited being used for the carriage of passengers at separate fares where the vehicle was being operated by a Driver without a Conductor did not as directed by the Driver an Inspector or a Notice displayed on the vehicle pay the fare for the journey in accordance with the direction  
        </span>
        
      </div>
    </pdk-foldable-text>
    <p
      class="govuk-!-margin-top-4 govuk-!-margin-bottom-4 govuk-body-s"
      ng-reflect-type="body-small"
      ng-reflect-vertical="4"
      pdk-margin-vertical="4"
      pdk-typography="body-small"
    >
       legislation 1 
    </p>
    
    <p
      class="govuk-!-margin-top-4 govuk-!-margin-bottom-4 govuk-body-s"
      ng-reflect-type="body-small"
      ng-reflect-vertical="4"
      pdk-margin-vertical="4"
      pdk-typography="body-small"
    >
       On 27 Jan 2019 
    </p>
    <div
      class="govuk-!-margin-top-6 govuk-!-margin-bottom-6"
      ng-reflect-vertical="6"
      pdk-margin-vertical="6"
    >
      <pdk-badge
        class="govuk-!-margin-right-4 pdk-badge"
        ng-reflect-right="4"
        pdk-margin-right="4"
      >
         Notified Not Guilty 
      </pdk-badge>
      
    </div>
  </defendant-offence>
</defendant-offence-test>
`;


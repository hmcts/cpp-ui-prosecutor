exports[`DefendantOffenceComponent should compile correctly 1`] = `
<defendant-offence-test
  kase={[Function Object]}
  offence={[Function Object]}
>
  <defendant-offence
    ng-reflect-kase="[object Object]"
    ng-reflect-offence="[object Object]"
  >
    <h2
      class="govuk-heading-l"
      ng-reflect-type="heading-large"
      pdk-typography="heading-large"
    >
       Offence 
      
    </h2>
    <defendant-offence-warnings
      ng-reflect-offence="[object Object]"
    >
       {
    "id": "offenceId1",
    "offenceCode": "CA03013",
    "title": "offence title 1",
    "legislation": "legislation 2",
    "offenceSequenceNumber": 1,
    "wording": "On 02/07/2015 At threadneedle street EC2 Being a passenger on a Public service Vehicle operated on ..",
    "cjsCode": "CA03013",
    "sequenceNumber": 1,
    "startDate": "2019-01-19",
    "chargeDate": "2019-01-24",
    "compensation": 30,
    "withdrawalRequestReasonId": "1",
    "withdrawalRequestReason": "Insufficient Evidence",
    "prosecutionFacts": "An incident took place at GREEN PARK station whereby you were spoken to by a member of London .."
  } 
    </defendant-offence-warnings>
    <h3
      class="govuk-heading-m"
      ng-reflect-type="heading-medium"
      pdk-typography="heading-medium"
    >
      offence title 1
    </h3>
    <pdk-foldable-text
      _nghost-a-c0=""
      class="govuk-body-m"
      ng-reflect-type="body-medium"
      pdk-typography="body-medium"
    >
      <div
        _ngcontent-a-c0=""
        class="pdk-foldable"
      >
        <span
          _ngcontent-a-c0=""
          class="pdk-foldable__content"
          id="pdk-foldable-text-1"
        >
           On 02/07/2015 At threadneedle street EC2 Being a passenger on a Public service Vehicle operated on .. 
        </span>
        
      </div>
    </pdk-foldable-text>
    <p
      class="govuk-!-margin-top-4 govuk-!-margin-bottom-4 govuk-body-s"
      ng-reflect-type="body-small"
      ng-reflect-vertical="4"
      pdk-margin-vertical="4"
      pdk-typography="body-small"
    >
       legislation 2 
    </p>
    
    <p
      class="govuk-!-margin-top-4 govuk-!-margin-bottom-4 govuk-body-s"
      ng-reflect-type="body-small"
      ng-reflect-vertical="4"
      pdk-margin-vertical="4"
      pdk-typography="body-small"
    >
       On 24 Jan 2019 
    </p>
    <div
      class="govuk-!-margin-top-6 govuk-!-margin-bottom-6"
      ng-reflect-vertical="6"
      pdk-margin-vertical="6"
    >
      <pdk-badge
        class="govuk-!-margin-right-4 pdk-badge"
        ng-reflect-right="4"
        pdk-margin-right="4"
      >
         No plea received 
      </pdk-badge>
      
    </div>
  </defendant-offence>
</defendant-offence-test>
`;


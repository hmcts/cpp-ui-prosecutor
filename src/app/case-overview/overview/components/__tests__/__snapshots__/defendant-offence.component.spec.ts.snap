      pdk-margin-vertical="6"
    >
      <pdk-badge
        class="govuk-!-margin-right-4 pdk-badge"
        ng-reflect-right="4"
        pdk-margin-right="4"
      >
         No plea received 
      </pdk-badge>
      
    </div>
  </defendant-offence>
</defendant-offence-test>
`;


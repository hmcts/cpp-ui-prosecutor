              class="govuk-button"
              disabled="disabled"
              pdk-button=""
              type="submit"
            >
              Confirm
            </button>
            <div
              class="govuk-!-margin-top-0"
              pdk-margin-top="0"
            >
              <a
                class="govuk-link govuk-body-m"
                data-test-id="cancel-withdrawal"
                href="/"
                pdk-link=""
                pdk-typography="body-medium"
                routerlink="../"
              >
                 Cancel 
              </a>
            </div>
          </div>
        </form>
      </withdraw-list-form>
    </pdk-grid>
  </pdk-grid>
</withdraw-offence-list>
`;

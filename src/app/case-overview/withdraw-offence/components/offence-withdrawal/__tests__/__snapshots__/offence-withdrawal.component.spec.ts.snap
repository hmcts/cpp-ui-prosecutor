                              class="govuk-radios__label govuk-label"
                              for="pdk-radio-GENERATED_ID"
                              pdk-label=""
                            >
                               First option 
                            </label>
                          </div>
                        </pdk-radio-button>
                        <pdk-radio-button>
                          <div
                            class="govuk-radios__item"
                          >
                            <input
                              class="govuk-radios__input"
                              id="pdk-radio-GENERATED_ID"
                              name="pdk-radio-group-GENERATED_ID"
                              type="radio"
                              value="2"
                            />
                            <label
                              class="govuk-radios__label govuk-label"
                              for="pdk-radio-GENERATED_ID"
                              pdk-label=""
                            >
                               Second option 
                            </label>
                          </div>
                        </pdk-radio-button>
                      </div>
                    </pdk-radio-group>
                  </fieldset>
                </pdk-form-group>

  index={[Function Number]}
  offence={[Function Object]}
  offenceWithdrawalReasons={[Function Array]}
>
  <form
    class="ng-untouched ng-pristine ng-valid"
    novalidate=""
  >
    <offence-withdrawal-component
      ng-reflect-index="1"
      ng-reflect-offence="[object Object]"
      ng-reflect-offence-withdrawal-reasons="[object Object],[object Object"
    >
      
      <div
        class="govuk-!-margin-top-5 govuk-!-margin-bottom-5 govuk-body-m"
        ng-reflect-type="body-medium"
        ng-reflect-vertical="5"
        pdk-margin-vertical="5"
        pdk-typography="body-medium"
      >
        <pdk-divider>
          <hr
            class="pdk-divider"
          />
        </pdk-divider>
        <div
          class="govuk-!-margin-0"
          ng-reflect-margin="0"
          pdk-margin="0"
        >
          <b>
            Offence 
            
            <span>
              1
            </span>
            : offence title 1
          </b>
        </div>
        <pdk-foldable-text
          _nghost-a-c1=""
          class="govuk-!-margin-top-2"
          ng-reflect-top="2"
          pdk-margin-top="2"
        >
          <div
            _ngcontent-a-c1=""
            class="pdk-foldable"
          >
            <span
              _ngcontent-a-c1=""
              aria-expanded="false"
              class="pdk-foldable__content"
              id="pdk-foldable-text-1"
            >
               On 02/07/2015 At threadneedle street EC2 Being a passenger on a Public service Vehicle operated on .. 
            </span>
            
          </div>
        </pdk-foldable-text>
        
        <pdk-form-field>
          
          <pdk-form-group
            class="pdk-form-group"

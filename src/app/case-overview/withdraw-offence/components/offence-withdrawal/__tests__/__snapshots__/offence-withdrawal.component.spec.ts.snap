exports[`OffenceWithdrawalComponent should compile correctly 1`] = `
<offence-component-test
  number={[Function Number]}
  offence={[Function Object]}
>
  <form
    class="ng-untouched ng-pristine ng-valid"
    novalidate=""
  >
    <offence-withdrawal-component
      ng-reflect-number="1"
      ng-reflect-offence="[object Object]"
    >
      
      <div
        class="govuk-!-margin-top-5 govuk-!-margin-bottom-5 govuk-body-m"
        ng-reflect-type="body-medium"
        ng-reflect-vertical="5"
        pdk-margin-vertical="5"
        pdk-typography="body-medium"
      >
        <pdk-divider>
          <hr
            class="pdk-divider"
          />
        </pdk-divider>
        
        <div
          class="govuk-!-margin-0"
          ng-reflect-margin="0"
          pdk-margin="0"
        >
          <b>
            Offence 1: offence title 1
          </b>
        </div>
        <pdk-foldable-text
          _nghost-c1=""
          class="govuk-!-margin-top-2"
          ng-reflect-top="2"
          pdk-margin-top="2"
        >
          <div
            _ngcontent-c1=""
            class="pdk-foldable"
          >
            <span
              _ngcontent-c1=""
              aria-expanded="false"
              class="pdk-foldable__content"
              id="pdk-foldable-text-1"
            >
               On 02/07/2015 At threadneedle street EC2 Being a passenger on a Public service Vehicle operated on .. 
            </span>
            
          </div>
        </pdk-foldable-text>
        
        <div
          class="govuk-!-margin-top-5 govuk-!-margin-bottom-5"
          ng-reflect-vertical="5"
          pdk-margin-vertical="5"
        >
          <pdk-badge
            class="pdk-badge"
          >
             Pending withdrawal 
          </pdk-badge>
        </div>
        <pdk-form-field>
          
          <pdk-form-group
            ng-reflect-error="false"
            style="display: block;"
          >
            
            <fieldset
              class="govuk-fieldset"
              pdk-fieldset=""
            >
              <legend
                class="govuk-fieldset__legend"
                ng-reflect-hidden="false"
                ng-reflect-type="default"
              >
                  
              </legend>
              
              
              
              <pdk-radio-group
                class="ng-untouched ng-pristine ng-valid"
                inline=""
                ng-reflect-inline=""
                ng-reflect-model="true"
                ng-reflect-name="offenceId1.withdraw"
                ng-reflect-required=""
                required=""
              >
                <div
                  class="govuk-radios govuk-radios--inline"
                >
                  
                  <pdk-radio-button
                    ng-reflect-value="true"
                  >
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-checkbox-4"
                        name="pdk-radio-group-3"
                        type="radio"
                        value="true"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-checkbox-4"
                        ng-reflect-type=""
                        pdk-label=""
                      >
                        Yes
                      </label>
                    </div>
                  </pdk-radio-button>
                  <pdk-radio-button
                    ng-reflect-value="false"
                  >
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-checkbox-5"
                        name="pdk-radio-group-3"
                        type="radio"
                        value="false"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-checkbox-5"
                        ng-reflect-type=""
                        pdk-label=""
                      >
                        No
                      </label>
                    </div>
                  </pdk-radio-button>
                </div>
              </pdk-radio-group>
              
              
              <pdk-form-field
                class="govuk-!-margin-top-5"
                errormessages="errorMessage"
                labelhidden="true"
                labeltype="small"
                ng-reflect-error-messages="errorMessage"
                ng-reflect-label="Offence 1: Reason for withdraw"
                ng-reflect-label-hidden="true"
                ng-reflect-label-type="small"
                ng-reflect-top="5"
                pdk-margin-top="5"
              >
                
                <pdk-form-group
                  ng-reflect-error="false"
                  style="display: block;"
                >
                  
                  <fieldset
                    class="govuk-fieldset"
                    pdk-fieldset=""
                  >
                    <legend
                      class="govuk-visually-hidden govuk-fieldset__legend govuk-fieldset__legend--s"
                      ng-reflect-hidden="true"
                      ng-reflect-type="small"
                    >
                       Offence 1: Reason for withdrawing 
                    </legend>
                    
                    
                    
                    <label
                      class="govuk-label govuk-label--s"
                      ng-reflect-type="small"
                      pdk-label="small"
                    >
                      Reason for withdrawing
                    </label>
                    <pdk-radio-group
                      class="ng-untouched ng-pristine ng-valid"
                      ng-reflect-model="some reason"
                      ng-reflect-name="offenceId1.reason"
                      ng-reflect-options="[object Object],[object Object"
                      ng-reflect-required=""
                      required=""
                    >
                      <div
                        class="govuk-radios"
                      >
                        
                        <pdk-radio-button
                          ng-reflect-value="Insufficient evidence"
                        >
                          <div
                            class="govuk-radios__item"
                          >
                            <input
                              class="govuk-radios__input"
                              id="pdk-checkbox-8"
                              name="pdk-radio-group-7"
                              type="radio"
                              value="Insufficient evidence"
                            />
                            <label
                              class="govuk-radios__label govuk-label"
                              for="pdk-checkbox-8"
                              ng-reflect-type=""
                              pdk-label=""
                            >
                               Insufficient evidence 
                            </label>
                          </div>
                        </pdk-radio-button>
                        <pdk-radio-button
                          ng-reflect-value="Agreement between prosecutor a"
                        >
                          <div
                            class="govuk-radios__item"
                          >
                            <input
                              class="govuk-radios__input"
                              id="pdk-checkbox-9"
                              name="pdk-radio-group-7"
                              type="radio"
                              value="Agreement between prosecutor and defendant reached"
                            />
                            <label
                              class="govuk-radios__label govuk-label"
                              for="pdk-checkbox-9"
                              ng-reflect-type=""
                              pdk-label=""
                            >
                               Agreement between prosecutor and defendant reached 
                            </label>
                          </div>
                        </pdk-radio-button>
                        <pdk-radio-button
                          ng-reflect-value="Not in public interest to proc"
                        >
                          <div
                            class="govuk-radios__item"
                          >
                            <input
                              class="govuk-radios__input"
                              id="pdk-checkbox-10"
                              name="pdk-radio-group-7"
                              type="radio"
                              value="Not in public interest to proceed"
                            />
                            <label
                              class="govuk-radios__label govuk-label"
                              for="pdk-checkbox-10"
                              ng-reflect-type=""
                              pdk-label=""
                            >
                               Not in public interest to proceed 
                            </label>
                          </div>
                        </pdk-radio-button>
                        <pdk-radio-button
                          ng-reflect-value="Other"
                        >
                          <div
                            class="govuk-radios__item"
                          >
                            <input
                              class="govuk-radios__input"
                              id="pdk-checkbox-11"
                              name="pdk-radio-group-7"
                              type="radio"
                              value="Other"
                            />
                            <label
                              class="govuk-radios__label govuk-label"
                              for="pdk-checkbox-11"
                              ng-reflect-type=""
                              pdk-label=""
                            >
                               Other 
                            </label>
                          </div>
                        </pdk-radio-button>
                      </div>
                    </pdk-radio-group>
                    
                  </fieldset>
                  
                </pdk-form-group>
              </pdk-form-field>
              
            </fieldset>
            
          </pdk-form-group>
        </pdk-form-field>
      </div>
    </offence-withdrawal-component>
  </form>
</offence-component-test>
`;


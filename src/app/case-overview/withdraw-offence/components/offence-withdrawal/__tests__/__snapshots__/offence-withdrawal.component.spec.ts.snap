          pdk-margin="0"
        >
          <b>
            Offence 
            <span>
              1
            </span>
            : offence title 1
          </b>
        </div>
        <pdk-foldable-text
          class="govuk-!-margin-top-2"
          pdk-margin-top="2"
        >
          <div
            class="pdk-foldable"
          >
            <span
              class="pdk-foldable__content pdk-foldable__content__single"
              id="pdk-foldable-text-GENERATED_ID"
            >
               On 02/07/2015 At threadneedle street EC2 Being a passenger on a Public service Vehicle operated on .. 
            </span>
          </div>
        </pdk-foldable-text>
        <pdk-form-field>
          <pdk-form-group
            class="pdk-form-group"
          >
            <fieldset
              class="govuk-fieldset"
              pdk-fieldset=""
            >
              <div
                class="govuk-!-margin-top-5 govuk-!-margin-bottom-5"
                pdk-margin-vertical="5"
              >

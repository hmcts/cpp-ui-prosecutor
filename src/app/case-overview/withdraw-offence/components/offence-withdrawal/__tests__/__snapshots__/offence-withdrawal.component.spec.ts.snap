                ng-reflect-name="offenceId1.withdraw"
                ng-reflect-required=""
                required=""
              >
                <div
                  class="govuk-radios govuk-radios--inline"
                >
                  
                  <pdk-radio-button
                    ng-reflect-value="true"
                  >
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-4"
                        name="pdk-radio-group-3"
                        type="radio"
                        value="true"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-4"
                        ng-reflect-type=""
                        pdk-label=""
                      >
                        Yes
                      </label>
                    </div>
                  </pdk-radio-button>
                  <pdk-radio-button
                    ng-reflect-value="false"
                  >
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-5"
                        name="pdk-radio-group-3"
                        type="radio"
                        value="false"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-5"
                        ng-reflect-type=""
                        pdk-label=""
                      >
                        No
                      </label>
                    </div>
                  </pdk-radio-button>
                </div>
              </pdk-radio-group>
              
              
              <pdk-form-field
                class="govuk-!-margin-top-5"
                label="Reason for withdrawing"
                labeltype="small"
                ng-reflect-error-messages="[object Object]"

                ng-reflect-label-for-error-summary="Offence 1: Reason for withdraw"
                ng-reflect-label-type="small"
                ng-reflect-top="5"
                pdk-margin-top="5"
              >
                
                <pdk-form-group
                  class="pdk-form-group"
                  ng-reflect-has-error="false"
                >
                  
                  <fieldset
                    class="govuk-fieldset"
                    pdk-fieldset=""
                  >
                    
                    <legend
                      class="govuk-fieldset__legend govuk-fieldset__legend--s"
                      ng-reflect-hidden="false"
                      ng-reflect-type="small"
                    >
                       Reason for withdrawing 
                    </legend>
                    
                    
                    
                    <pdk-radio-group
                      class="ng-untouched ng-pristine ng-valid"
                      ng-reflect-model="1"
                      ng-reflect-name="offenceId1.withdrawalRequestRe"

                  class="pdk-badge"
                >
                   Pending Withdrawal 
                </pdk-badge>
              </div>
              <pdk-radio-group
                class="ng-untouched ng-pristine ng-valid"
                required=""
              >
                <div
                  class="govuk-radios govuk-radios--inline"
                >
                  <pdk-radio-button>
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="true"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        Yes
                      </label>
                    </div>
                  </pdk-radio-button>
                  <pdk-radio-button>
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="false"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        No
                      </label>
                    </div>
                  </pdk-radio-button>
                </div>
              </pdk-radio-group>
              <pdk-form-field
                class="govuk-!-margin-top-5"
                label="Reason for withdrawing"
                labeltype="small"
                pdk-margin-top="5"
              >
                <pdk-form-group
                  class="pdk-form-group"
                >
                  <fieldset
                    class="govuk-fieldset"
                    pdk-fieldset=""
                  >
                    <legend
                      class="govuk-fieldset__legend govuk-fieldset__legend--s"
                    >
                       Reason for withdrawing 
                    </legend>
                    <pdk-radio-group
                      class="ng-untouched ng-pristine ng-valid"
                      required=""
                    >
                      <div
                        class="govuk-radios"
                      >
                        <pdk-radio-button>
                          <div
                            class="govuk-radios__item"
                          >
                            <input
                              class="govuk-radios__input"
                              id="pdk-radio-GENERATED_ID"
                              name="pdk-radio-group-GENERATED_ID"
                              type="radio"
                              value="1"
                            />

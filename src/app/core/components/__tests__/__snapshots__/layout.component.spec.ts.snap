exports[`Layout should render correctly with api error 1`] = `
<app-layout
  apiError={[Function Boolean]}
  headerNavItems={[Function Array]}
>
  <pdk-cpp-layout
    ng-reflect-api-error="true"
    ng-reflect-cookie-message="true"
    ng-reflect-header-nav-items="[object Object],[object Object"
  >
    
    
    <pdk-alert>
      <div
        class="pdk-alert pdk-alert--warning"
        role="alert"
      >

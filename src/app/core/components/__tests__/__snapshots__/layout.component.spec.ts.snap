// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Layout should render 1`] = `
<app-layout
  headerNavItems={[Function Array]}
>
  <pdk-cpp-layout
    ng-reflect-cookie-message="true"
    ng-reflect-header-nav-items="[object Object],[object Object"
  >
    
    
    <pdk-skip-link
      ng-reflect-target="main-content"
      target="main-content"
    >
      <a
        class="govuk-skip-link"
        href="main-content"
      >
        Skip to main content
      </a>
    </pdk-skip-link>
    
    <pdk-cookie-message>
      <div
        class="pdk-cookie-message"
      >
        <p
          class="govuk-width-container"
        >
           GOV.UK uses cookies to make the site simpler. 
          <a
            class="govuk-link"
            href="https://www.gov.uk/help/cookies"
            pdk-link=""
          >
            Find out more about cookies.
          </a>
        </p>
      </div>
    </pdk-cookie-message>
    <pdk-header>
      <header
        class="govuk-header js-enabled"
        data-module="header"
        role="banner"
      >
        <div
          class="govuk-header__container govuk-width-container"
        >
          <div
            class="pdk-header__content"
          >
            <a
              class="govuk-header__link govuk-header__link--service-name"
              href="#"
              pdk-header-title=""
            >
              Common Platform Programme
            </a>
            
            
            <pdk-header-nav>
              <button
                aria-controls="navigation"
                aria-expanded="false"
                aria-label="Show or hide Top Level Navigation"
                class="govuk-header__menu-button"
                type="button"
              >
                 Menu 
              </button>
              <nav>
                <div
                  aria-label="Top Level Navigation"
                  class="govuk-header__navigation"
                  role="list"
                >
                  
                  <pdk-header-nav-item
                    class="govuk-header__navigation-item"
                    role="list-item"
                  >
                    <a
                      class="govuk-header__link"
                      href="http://account"
                      pdk-header-link=""
                    >
                      Your account
                    </a>
                  </pdk-header-nav-item>
                  <pdk-header-nav-item
                    class="govuk-header__navigation-item"
                    role="list-item"
                  >
                    <a
                      class="govuk-header__link"
                      href="http://signout"
                      pdk-header-link=""
                    >
                      Sign out
                    </a>
                  </pdk-header-nav-item>
                </div>
              </nav>
            </pdk-header-nav>
          </div>
        </div>
      </header>
    </pdk-header>
    <pdk-container
      class="govuk-width-container"
      style="display: block;"
    >
      <pdk-phase-banner
        _nghost-c5=""
        ng-reflect-type="beta"
      >
        <div
          _ngcontent-c5=""
          class="govuk-phase-banner"
        >
          <p
            _ngcontent-c5=""
            class="govuk-phase-banner__content"
          >
            <strong
              _ngcontent-c5=""
              class="govuk-tag govuk-phase-banner__content__tag"
            >
              beta
            </strong>
            <span
              _ngcontent-c5=""
              class="govuk-phase-banner__text"
            >
               This is a new service – your 
              <a
                class="govuk-link"
                href="javascript:void(0)"
                pdk-link=""
              >
                feedback
              </a>
               will help us improve it 
            </span>
          </p>
        </div>
      </pdk-phase-banner>
    </pdk-container>
    <pdk-main
      id="main-content"
      ng-reflect-id="main-content"
    >
      <main
        class="govuk-!-margin-bottom-9 govuk-width-container"
        id="main-content"
        ng-reflect-bottom="9"
        pdk-container=""
        pdk-margin-bottom="9"
        style="display: block;"
      />
    </pdk-main>
    <pdk-footer>
      <footer
        class="govuk-footer"
        role="contentinfo"
      >
        <div
          class="govuk-width-container"
        >
          <pdk-footer-meta>
            <div
              class="govuk-footer__meta"
            >
              <div
                class="pdk-footer__meta-item govuk-footer__meta-item govuk-footer__meta-item--grow"
              >
                <h2
                  class="govuk-heading-m"
                  ng-reflect-type="heading-medium"
                  pdk-typography="heading-medium"
                >
                  Help desk
                </h2>
                <dl>
                  <dt>
                    Telephone
                  </dt>
                  <dd>
                    0207 633 4140
                  </dd>
                  <dd>
                    Monday to Friday, 8am to 6pm (excluding public holidays)
                  </dd>
                </dl>
                <h3>
                  Help by email
                </h3>
                <dl>
                  <dt>
                    CPS users only
                  </dt>
                  <dd>
                    <a
                      class="govuk-footer__link"
                      href="mailto:CJSCP-ServiceDesk@hmcts.gsi.gov.uk?Subject=General%20enquiry"
                      pdk-footer-link=""
                    >
                       CJSCP-ServiceDesk@hmcts.gsi.gov.uk 
                    </a>
                  </dd>
                  <dt>
                    All other users
                  </dt>
                  <dd>
                    <a
                      class="govuk-footer__link"
                      href="mailto:CJSCP-ServiceDesk@hmcts.net?Subject=General%20enquiry"
                      pdk-footer-link=""
                    >
                       CJSCP-ServiceDesk@hmcts.net 
                    </a>
                  </dd>
                </dl>
              </div>
            </div>
          </pdk-footer-meta>
        </div>
      </footer>
    </pdk-footer>
  </pdk-cpp-layout>
</app-layout>
`;

exports[`Layout should render correctly with activity 1`] = `
<app-layout
  activity={[Function Boolean]}
  headerNavItems={[Function Array]}
>
  <pdk-cpp-layout
    ng-reflect-activity="true"
    ng-reflect-cookie-message="true"
    ng-reflect-header-nav-items="[object Object],[object Object"
  >
    
    <pdk-activity-indicator>
      <div
        class="pdk-activity-indicator"
      >
        <div
          class="pdk-activity-indicator__loader"
        >
          <div
            class="pdk-activity-indicator__spinner"
          />
          <b
            class="pdk_activity-indicator__title"
          >
            Page loading
          </b>
          <p
            style="margin-top: 4px"
          >
            This may take a moment, please wait.
          </p>
        </div>
      </div>
      <div
        class="pdk-activity-indicator__backdrop"
      />

exports[`Layout should render 1`] = `
<app-layout
  headerNavItems={[Function Array]}
>
  <pdk-cpp-layout
    _nghost-c0=""
    accessibilitylink="accessibility"
    ng-reflect-accessibility-link="accessibility"
    ng-reflect-cookie-message="true"
    ng-reflect-header-nav-items="[object Object],[object Object"
  >
    
    
    <pdk-skip-link
      _ngcontent-c0=""
      ng-reflect-target="main-content"
      target="main-content"
    >
      <a
        class="govuk-skip-link"
        href="javascript:void(0)"
      >
         Skip to main content 
      </a>
    </pdk-skip-link>
    
    <pdk-cookie-message
      _ngcontent-c0=""
    >
      <div
        class="pdk-cookie-message"
      >
        <p
          class="govuk-width-container"
        >
           GOV.UK uses cookies to make the site simpler. 
          <a
            class="govuk-link"
            href="https://www.gov.uk/help/cookies"
            pdk-link=""
          >
            Find out more about cookies.
          </a>
        </p>
      </div>
    </pdk-cookie-message>
    <pdk-header
      _ngcontent-c0=""
    >
      <header
        class="govuk-header js-enabled"
        data-module="header"
        role="banner"
      >
        <div
          class="govuk-header__container govuk-width-container"
        >
          <div
            class="pdk-header__content"
          >
            <a
              _ngcontent-c0=""
              class="govuk-header__link govuk-header__link--service-name"
              href="#"
              pdk-header-title=""
            >
              Common Platform Programme
            </a>
            <div
              _ngcontent-c0=""
              class="cpp-layout__header-content"
            >
              
              
              
              <pdk-header-nav
                _ngcontent-c0=""
              >
                <button
                  aria-controls="navigation"
                  aria-expanded="false"
                  aria-label="Show or hide Top Level Navigation"
                  class="govuk-header__menu-button"
                  type="button"
                >
                   Menu 
                </button>
                <nav>
                  <div
                    aria-label="Top Level Navigation"
                    class="govuk-header__navigation"
                    role="list"
                  >
                    
                    <pdk-header-nav-item
                      _ngcontent-c0=""
                      class="govuk-header__navigation-item"
                      role="listitem"
                    >
                      <a
                        _ngcontent-c0=""
                        class="govuk-header__link"
                        href="http://account"
                        pdk-header-link=""
                      >
                         Your account 
                      </a>
                    </pdk-header-nav-item>
                    <pdk-header-nav-item
                      _ngcontent-c0=""
                      class="govuk-header__navigation-item"
                      role="listitem"
                    >
                      <a
                        _ngcontent-c0=""
                        class="govuk-header__link"
                        href="http://signout"
                        pdk-header-link=""
                      >
                         Sign out 
                      </a>
                    </pdk-header-nav-item>
                  </div>
                </nav>
              </pdk-header-nav>
            </div>
          </div>
        </div>
      </header>
    </pdk-header>
    <pdk-container
      _ngcontent-c0=""
      class="govuk-width-container"
      style="display: block;"
    >
      <pdk-phase-banner
        _ngcontent-c0=""
        ng-reflect-type="beta"
      >
        <p
          class="govuk-phase-banner__content"
        >
          <strong
            class="govuk-tag govuk-phase-banner__content__tag"
          >
            beta
          </strong>
          <span
            class="govuk-phase-banner__text"
          >
             This is a new service – your 
            <a
              _ngcontent-c0=""
              class="govuk-link"
              data-test-id="feedback"
              href="javascript:void(0)"
              pdk-link=""
            >
              feedback
            </a>
             will help us improve it 
          </span>
        </p>
      </pdk-phase-banner>
    </pdk-container>
    <pdk-main
      _ngcontent-c0=""
      class="govuk-body-m"
      contentid="main-content"
      ng-reflect-content-id="main-content"
      ng-reflect-type="body"
      pdk-typography="body"
    >
      <main
        class="govuk-main-wrapper govuk-!-margin-bottom-9 govuk-width-container"
        id="main-content"
        ng-reflect-bottom="9"
        pdk-container=""
        pdk-margin-bottom="9"
        style="display: block;"
      />
    </pdk-main>
    <pdk-footer
      _ngcontent-c0=""
    >
      <footer
        class="govuk-footer"
        role="contentinfo"
      >
        <div
          class="govuk-width-container"
        >
          <pdk-footer-meta
            _ngcontent-c0=""
          >
            <div
              class="govuk-footer__meta"
            >
              <div
                class="pdk-footer__meta-item govuk-footer__meta-item govuk-footer__meta-item--grow"
              >
                <h2
                  _ngcontent-c0=""
                  class="govuk-heading-m"
                  ng-reflect-type="heading-medium"
                  pdk-typography="heading-medium"
                >
                  Help desk
                </h2>
                <dl
                  _ngcontent-c0=""
                >
                  <dt
                    _ngcontent-c0=""
                  >
                    Telephone
                  </dt>
                  <dd
                    _ngcontent-c0=""
                  >
                    0300 303 0688
                  </dd>
                  <dd
                    _ngcontent-c0=""
                  >
                    Monday to Friday, 8am to 6pm (excluding public holidays)
                  </dd>
                </dl>
                <h3
                  _ngcontent-c0=""
                >
                  Help by email
                </h3>
                <dl
                  _ngcontent-c0=""
                >
                  <dt
                    _ngcontent-c0=""
                  >
                    CPS users only
                  </dt>
                  <dd
                    _ngcontent-c0=""
                  >
                    <a
                      _ngcontent-c0=""
                      class="govuk-footer__link"
                      href="mailto:CJSCP-ServiceDesk@hmcts.gsi.gov.uk?Subject=General%20enquiry"
                      pdk-footer-link=""
                    >
                       CJSCP-ServiceDesk@hmcts.gsi.gov.uk 
                    </a>
                  </dd>
                  <dt
                    _ngcontent-c0=""
                  >
                    All other users
                  </dt>
                  <dd
                    _ngcontent-c0=""
                  >
                    <a
                      _ngcontent-c0=""
                      class="govuk-footer__link"
                      href="mailto:CJSCP-ServiceDesk@hmcts.net?Subject=General%20enquiry"
                      pdk-footer-link=""
                    >
                       CJSCP-ServiceDesk@hmcts.net 
                    </a>
                  </dd>
                </dl>
              </div>
            </div>
          </pdk-footer-meta>
          <pdk-footer-list
            _ngcontent-c0=""
          >
            <hr
              class="govuk-footer__section-break"
            />
            <div
              class="govuk-footer__inline-list"
              role="list"
            >
              
              
              <pdk-footer-list-item
                _ngcontent-c0=""
                role="listitem"
              >
                <div
                  class="govuk-footer__inline-list-item"
                >
                  <a
                    _ngcontent-c0=""
                    class="govuk-footer__link"
                    href="https://www.gov.uk/help/cookies"
                    pdk-footer-link=""
                    target="_blank"
                  >
                    Cookies
                  </a>
                </div>
              </pdk-footer-list-item>
              
              <pdk-footer-list-item
                _ngcontent-c0=""
                role="listitem"
              >
                <div
                  class="govuk-footer__inline-list-item"
                >
                  <a
                    _ngcontent-c0=""

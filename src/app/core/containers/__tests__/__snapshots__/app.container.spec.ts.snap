>
  <pdk-provider>
    <div
      class="js-enabled"
    >
      <cpp-application-layout
        accessibilitylink="accessibility"
        searchlabel="Search by case or application reference"
        searchplaceholder="Search by reference"
        servicename="CJS Common Platform"
      >
        <pdk-activity-indicator>
          <div
            class="pdk-activity-indicator"
          >
            <div
              class="pdk-activity-indicator__loader"
              role="status"
            >
              <div
                class="pdk-activity-indicator__spinner"
              />
              <b
                class="pdk_activity-indicator__title"
              >
                Page loading
              </b>
              <p
                style="margin-top: 4px;"
              >
                This may take a moment, please wait.
              </p>
            </div>
          </div>
          <div
            class="pdk-activity-indicator__backdrop"
          />
        </pdk-activity-indicator>
        <pdk-skip-link
          target="main-content"
        >
          <a
            class="govuk-skip-link"
            href="javascript:void(0)"
          >
             Skip to main content 
          </a>
        </pdk-skip-link>
        <cpp-application-cookies-banner>
          <pdk-cookie-banner
            heading="Cookies on Common Platform"
          >
            <div
              aria-label="Cookies on Common Platform"
              class="govuk-cookie-banner"
              data-nosnippet=""
              role="region"
            >
              <div
                class="govuk-width-container"
              >
                <pdk-grid
                  class="govuk-grid-row"
                  container=""
                >
                  <pdk-grid
                    class="govuk-grid-column-two-thirds"
                    two-thirds=""
                  >
                    <h2
                      class="govuk-cookie-banner__heading govuk-heading-m"
                      pdk-typography="heading-medium"
                    >
                       Cookies on Common Platform 
                    </h2>
                  </pdk-grid>
                </pdk-grid>
                <pdk-cookie-banner-content>
                  <pdk-grid
                    class="govuk-grid-row"
                    container=""
                  >
                    <pdk-grid
                      class="govuk-grid-column-two-thirds"
                      two-thirds=""
                    >
                      <div
                        class="pdk-cookie-banner__content"
                      >
                        <p
                          class="govuk-body-m"
                          pdk-typography="body"
                        >
                          We use some essential cookies to make the application work.
                        </p>
                        <p
                          class="govuk-body-m"
                          pdk-typography="body"
                        >
                           We’d like to set additional cookies to understand how you use Common Platform, remember your settings and improve your experience. 
                        </p>
                      </div>
                    </pdk-grid>
                  </pdk-grid>
                </pdk-cookie-banner-content>
                <pdk-button-group>
                  <div
                    class="govuk-button-group"
                  >
                    <button
                      class="govuk-button"
                      data-test-id="acceptCookies"
                      pdk-button=""
                    >
                       Accept additional cookies 
                    </button>
                    <button
                      class="govuk-button"
                      data-test-id="rejectCookies"
                      pdk-button=""
                    >
                       Reject additional cookies 
                    </button>
                    <a
                      class="govuk-link"
                      href="/cookies?referrer=http%3A%2F%2Flocalhost%2F"
                      pdk-link=""
                    >
                      View cookies
                    </a>
                  </div>
                </pdk-button-group>
              </div>
            </div>
          </pdk-cookie-banner>
        </cpp-application-cookies-banner>
        <pdk-header>
          <header
            class="govuk-header js-enabled"
          >
            <div
              class="govuk-header__container govuk-width-container"
            >
              <div
                class="pdk-header__content"
              >
                <a
                  class="govuk-header__link govuk-header__service-name"
                  href="#"
                  pdk-header-title=""
                >
                  CJS Common Platform
                </a>
                <div
                  class="cpp-layout__header-content"
                >
                  <form
                    class="cpp-layout__search ng-untouched ng-pristine ng-valid"
                    novalidate=""
                  >
                    <pdk-searchbar
                      borderless=""
                      class="ng-untouched ng-pristine ng-valid"
                      name="q"
                      ngmodel=""
                    >
                      <div
                        class="pdk-searchbar"
                      >
                        <input
                          aria-label="Search by case or application reference"
                          class="pdk-searchbar__input pdk-searchbar__input--borderless govuk-input"
                          id="searchbar_pdk-search-GENERATED_ID"
                          pdk-input=""
                          placeholder="Search by reference"
                          type="text"
                        />
                        <button
                          class="pdk-searchbar__button pdk-searchbar__button--borderless"
                          type="submit"
                        >
                          <pdk-search-icon
                            color="#fff"
                            style="display: flex; align-items: center; justify-content: center;"
                          >
                            <i
                              style="height: 20px; width: 20px; fill: #fff;"
                            >
                              <svg
                                height="100%"
                                viewBox="0 0 512 512"
                                width="100%"
                              >
                                <path
                                  d="M505 442.7L405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128 0-70.7 57.2-128 128-128 70.7 0 128 57.2 128 128 0 70.7-57.2 128-128 128z"
                                />
                              </svg>
                            </i>
                          </pdk-search-icon>
                          <span
                            class="pdk-searchbar__label govuk-visually-hidden"
                            pdk-visually-hidden=""
                          >
                             Search by case or application reference 
                          </span>
                        </button>
                      </div>
                    </pdk-searchbar>
                  </form>
                  <pdk-header-nav>
                    <nav
                      aria-label="Top Level Navigation"
                      class="govuk-header__navigation"
                    >
                      <button
                        aria-controls="navigation"
                        aria-expanded="false"
                        aria-label="Show or hide Top Level Navigation"
                        class="govuk-header__menu-button"
                        type="button"
                      >
                         Menu 
                      </button>
                      <div
                        class="govuk-header__navigation-list"
                        hidden=""
                        role="list"
                      >
                        <pdk-header-nav-item
                          class="govuk-header__navigation-item"
                          role="listitem"
                        >
                          <a
                            class="govuk-header__link"
                            href="https://cpp.home.nonlive/search?referrer=http%3A%2F%2Flocalhost%2F"
                            pdk-header-link=""
                          >
                             Detailed search 
                          </a>
                        </pdk-header-nav-item>
                        <pdk-header-nav-item
                          class="govuk-header__navigation-item"
                          role="listitem"
                        >
                          <a
                            class="govuk-header__link"
                            href="path/to/home"
                            pdk-header-link=""
                          >
                             Home 
                          </a>
                        </pdk-header-nav-item>
                        <pdk-header-nav-item
                          class="govuk-header__navigation-item"
                          role="listitem"
                        >
                          <a
                            class="govuk-header__link"
                            href="path/to/account"
                            pdk-header-link=""
                          >
                             Your account 
                          </a>
                        </pdk-header-nav-item>
                        <pdk-header-nav-item
                          class="govuk-header__navigation-item"
                          role="listitem"
                        >
                          <a
                            class="govuk-header__link"
                            href="path/to/logout"
                            pdk-header-link=""
                          >
                             Sign out 
                          </a>
                        </pdk-header-nav-item>
                        <pdk-header-nav-item
                          class="govuk-header__navigation-item"
                          role="listitem"
                        >
                          <a
                            class="govuk-header__link"
                            href="/prosecutor/dev-tools"
                            pdk-header-link=""
                          >
                             Dev tools 
                          </a>
                        </pdk-header-nav-item>
                      </div>
                    </nav>
                  </pdk-header-nav>
                </div>
              </div>
            </div>
          </header>
        </pdk-header>
        <pdk-container
          class="govuk-width-container"
          style="display: block;"
        >
          <pdk-phase-banner>
            <p
              class="govuk-phase-banner__content"
            >
              <strong
                class="govuk-tag govuk-phase-banner__content__tag"
              >
                beta
              </strong>
              <span
                class="govuk-phase-banner__text"
              >
                This is a new service
              </span>
            </p>
          </pdk-phase-banner>
        </pdk-container>
        <pdk-main
          class="govuk-body-m"
          contentid="main-content"
          pdk-typography="body"
        >
          <main
            class="govuk-main-wrapper govuk-!-margin-bottom-9 govuk-width-container"
            id="main-content"
            pdk-container=""
            pdk-margin-bottom="9"
            style="display: block;"
            tabindex="-1"
          >
            <router-container>
              <router-outlet />
            </router-container>
          </main>
        </pdk-main>
        <pdk-footer>
          <footer
            class="govuk-footer"
          >
            <div
              class="govuk-width-container"
            >
              <pdk-footer-meta>
                <div
                  class="govuk-footer__meta"
                >
                  <div
                    class="pdk-footer__meta-item govuk-footer__meta-item govuk-footer__meta-item--grow"
                  >
                    <h2
                      class="govuk-heading-m"
                      pdk-typography="heading-medium"
                    >
                      Help desk
                    </h2>
                    <div>
                      HMCTS DTS IT Service Desk
                    </div>
                    <dl>
                      <dt>
                        Telephone
                      </dt>
                      <dd>
                        0203 989 6060
                      </dd>
                      <dd>
                        Monday to Friday, 8am to 8pm and Saturday, 8am to 2pm (excluding public holidays)
                      </dd>
                    </dl>
                    <dl>
                      <dt>
                        Email
                      </dt>
                      <dd>
                        <a
                          class="govuk-footer__link"
                          href="mailto:CJSCP-ServiceDesk@hmcts.net?Subject=General%20enquiry"
                          pdk-footer-link=""
                        >
                           CJSCP-ServiceDesk@hmcts.net 
                        </a>
                      </dd>
                    </dl>
                  </div>
                </div>
              </pdk-footer-meta>
              <pdk-footer-list>
                <hr
                  class="govuk-footer__section-break"
                />
                <div
                  class="govuk-footer__inline-list"
                  role="list"
                >
                  <pdk-footer-list-item
                    role="listitem"
                  >
                    <div
                      class="govuk-footer__inline-list-item"
                    >
                      <a
                        class="govuk-footer__link"
                        href="/terms-and-conditions"
                        pdk-footer-link=""
                        target="_blank"
                      >
                        Terms and conditions
                      </a>
                    </div>
                  </pdk-footer-list-item>
                  <pdk-footer-list-item
                    role="listitem"
                  >
                    <div
                      class="govuk-footer__inline-list-item"
                    >
                      <a
                        class="govuk-footer__link"
                        href="/cookies"
                        pdk-footer-link=""
                      >
                        Cookies
                      </a>
                    </div>
                  </pdk-footer-list-item>
                  <pdk-footer-list-item
                    role="listitem"
                  >
                    <div
                      class="govuk-footer__inline-list-item"
                    >
                      <a
                        class="govuk-footer__link"
                        href="accessibility"
                        pdk-footer-link=""
                        target="_blank"
                      >
                        Accessibility
                      </a>
                    </div>
                  </pdk-footer-list-item>
                </div>
              </pdk-footer-list>
            </div>
          </footer>
        </pdk-footer>
      </cpp-application-layout>
    </div>
  </pdk-provider>
</app-root>
`;


exports[`App page component should compile correctly 1`] = `
<app-root
  apiError$={[Function Store]}
  devTools={[Function Boolean]}
  headerNavItems={[Function Array]}
  isBusy$={[Function Observable]}
  offline$={[Function Observable]}
>
  <pdk-provider>
    <div
      class="js-enabled"
    >
      <app-layout
        ng-reflect-activity="false"
        ng-reflect-api-error="false"
        ng-reflect-header-nav-items="[object Object],[object Object"
        ng-reflect-offline="false"
      >
        <div>
          headerNavItems : [
    {
      "title": "Your account",
      "href": "path/to/account"
    },
    {
      "title": "Sign out",
      "href": "path/to/logout"
    },
    {
      "title": "Dev tools",
      "href": "/prosecutor/dev-tools"
    }
  ]
        </div>
        <div>
          activity: false
        </div>
        <div>
          offline: false
        </div>
        <div>
          apiError: false
        </div>
      </app-layout>
    </div>
  </pdk-provider>
</app-root>
`;


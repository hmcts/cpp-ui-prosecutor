                        target="_blank"
                      >
                        Accessibility
                      </a>
                    </div>
                  </pdk-footer-list-item>
                </div>
              </pdk-footer-list>
            </div>
          </footer>
        </pdk-footer>
      </cpp-application-layout>
    </div>
  </pdk-provider>
</app-root>
`;

      "href": "/prosecutor/dev-tools"
    }
  ]
      </div>
      <div>
        activity: 
      </div>
      <div>
        offline: false
      </div>
      <div>
        apiError: false
      </div>
    </app-layout>
  </pdk-provider>
</app-root>
`;

exports[`App page component should detect when the app is busy 1`] = `
<app-root
  apiError$={[Function Store]}
  devTools={[Function Boolean]}
  headerNavItems={[Function Array]}
  isBusy$={[Function Observable]}
  offline$={[Function Observable]}
>
  <pdk-provider>
    <app-layout
      ng-reflect-activity="true"
      ng-reflect-api-error="false"
      ng-reflect-header-nav-items="[object Object],[object Object"
      ng-reflect-offline="false"
    >
      <div>
        headerNavItems : [
    {
      "title": "Your account",
      "href": "path/to/account"
    },
    {
      "title": "Sign out",
      "href": "path/to/logout"
    },
    {
      "title": "Dev tools",
      "href": "/prosecutor/dev-tools"
    }
  ]
      </div>
      <div>
        activity: true
      </div>
      <div>
        offline: false
      </div>
      <div>
        apiError: false
      </div>
    </app-layout>
  </pdk-provider>
</app-root>
`;


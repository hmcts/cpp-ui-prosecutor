// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`AccessibilityComponent should render correctly 1`] = `
<atcm-accessibility>
  <pdk-grid
    class="govuk-grid-row"
    container=""
  >
    <pdk-grid
      class="govuk-grid-column-one-third"
      one-third=""
    >
      <h1
        class="heading-medium"
        style="margin-top: 60px;"
      >
         Contents 
      </h1>
      <ul
        class="list list-view"
      >
        <li>
          <a
            class="govuk-link"
            fragment="a11y-statement"
            href="/#a11y-statement"
            pdk-link=""
          >
             Accessibility statement for ATCM 
          </a>
        </li>
        <li>
          <a
            class="govuk-link"
            fragment="a11y-what-to-do"
            href="/#a11y-what-to-do"
            pdk-link=""
          >
             What to do if you can't access parts of this website 
          </a>
        </li>
        <li>
          <a
            class="govuk-link"
            fragment="a11y-enforcement-procedure"
            href="/#a11y-enforcement-procedure"
            pdk-link=""
          >
             Enforcement procedure 
          </a>
        </li>
        <li>
          <a
            class="govuk-link"
            fragment="a11y-technical-information"
            href="/#a11y-technical-information"
            pdk-link=""
          >
             Technical information about this website's accessibility 
          </a>
        </li>
        <li>
          <a
            class="govuk-link"
            fragment="a11y-what-we-re-doing"
            href="/#a11y-what-we-re-doing"
            pdk-link=""
          >
             What we're doing to improve accessibility 
          </a>
        </li>
      </ul>
    </pdk-grid>
    <pdk-grid
      class="govuk-grid-column-two-thirds"
      two-thirds=""
    >
      <h1
        bold=""
        compound=""
        pdk-page-title=""
        pdk-text=""
      >
         Accessibility statement for ATCM 
        <a
          id="a11y-statement"
        />
      </h1>
      <p
        pdk-text=""
      >
        The ATCM website is run by the Ministry of Justice Crime Reform Programme. We want as many people as possible to be able to use it. For example, that means you should be able to:
      </p>
      <ul
        class="list list-bullet"
      >
        <li
          pdk-text=""
        >
          change font size
        </li>
        <li
          pdk-text=""
        >
          zoom in up to 300% without the text spilling off the screen
        </li>
        <li
          pdk-text=""
        >
          navigate most of the website using just a keyboard
        </li>
        <li
          pdk-text=""
        >
          navigate most of the website using speech recognition software
        </li>
        <li
          pdk-text=""
        >
          listen to most of the website using a screen reader (including the most recent versions of JAWS, NVDA and VoiceOver)
        </li>
      </ul>
      <p
        pdk-text=""
      >
        We've also made the website text as simple as possible to understand.
      </p>
      <p
        pdk-text=""
      >
        <a
          href="https://mcmw.abilitynet.org.uk/"
          target="_blank"
        >
          AbilityNet (opens in new window)
        </a>
         has advice on making your device easier to use if you have a disability. 
      </p>
      <h2
        bold=""
        class="heading-medium"
        compound=""
      >
         What to do if you can't access parts of this website 
        <a
          id="a11y-what-to-do"
        />
      </h2>
      <p
        pdk-text=""
      >
         We're always looking to improve the accessibility of this website. If you find any problems that aren't listed on this page or think we're not meeting accessibility requirements, contact: 
      </p>
      <p
        pdk-text=""
      >
         • email 
        <a
          href="mailto:cjscp-pmo@hmcts.net"
          target="_blank"
        >
          cjscp-pmo@hmcts.net
        </a>
      </p>
      <p
        pdk-text=""
      >
         You will receive a reply within 10 working days. 
      </p>
      <h2
        bold=""
        class="heading-medium"
        compound=""
      >
         Enforcement procedure 
        <a
          id="a11y-enforcement-procedure"
        />
      </h2>
      <p
        pdk-text=""
      >
         The Equality and Human Rights Commission (EHRC) is responsible for enforcing the Public Sector Bodies (Websites and Mobile Applications) (No. 2) Accessibility Regulations 2018 (the 'accessibility regulations'). If you're not happy with how we respond to your complaint, contact the 
        <a
          href="https://www.equalityadvisoryservice.com/"
          target="_blank"
        >
           Equality Advisory and Support Service (EASS). (opens in new window) 
        </a>
      </p>
      <h2
        bold=""
        class="heading-medium"
        compound=""
      >
         Technical information about this website's accessibility 
        <a
          id="a11y-technical-information"
        />
      </h2>
      <p
        pdk-text=""
      >
        The Ministry of Justice Crime Reform Programme is committed to making its website accessible, in accordance with the Public Sector Bodies (Websites and Mobile Applications) (No. 2) Accessibility Regulations 2018.
      </p>
      <p
        pdk-text=""
      >
        We are currently conducting an internal accessibility audit of a representative sample of our screens in order to identify any accessibility issues. We plan to fix any accessibility issues it identifies up to the WCAG 2.1 AA standards apart from any which would be a disproportionate burden.
      </p>
      <h2
        bold=""
        class="heading-medium"
        compound=""
      >
         What we're doing to improve accessibility 
        <a
          id="a11y-what-we-re-doing"
        />
      </h2>
      <p
        pdk-text=""
      >
        We are currently conducting an internal accessibility audit of a representative sample of our screens in order to identify any other accessibility issues.
      </p>
      <p
        pdk-text=""
      >
        After this audit is complete we plan to review and update our internal platform development kit if necessary. This contains templates of common patterns and components which are then used consistently across the system. Ensuring these patterns and components are WCAG 2.1 AA compliant will make all instances of them across our systems compliant.
      </p>
      <p
        pdk-text=""
      >
        We will release front end development resources to fix other identified accessibility issues. We plan to do all this before our screens are released to their full user base.
      </p>
      <p
        pdk-text=""
      >
        We will also consider conducting external accessibility audits by the Digital Accessibility Centre (DAC) following subsequent major new code releases where this is appropriate.
      </p>
    </pdk-grid>
  </pdk-grid>
</atcm-accessibility>
`;

                </span>
              </div>
            </pdk-summary-item>
          </a>
          <a
            href=""
          >
            <pdk-summary-item
              class="pdk-!-text-color-blue"
              hero=""
              label="document errors in last upload"
              ng-reflect-count="5"
              ng-reflect-hero=""
              ng-reflect-label="document errors in last upload"
              ng-reflect-type="blue"
              pdk-text-colour="blue"
            >
              <div

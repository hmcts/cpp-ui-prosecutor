            ng-reflect-type="heading-medium"
            pdk-margin-top="8"
            pdk-typography="heading-medium"
          >
            Send SJP notices and other documents
          </h2>
          <div>
            <a
              class="govuk-link"
              href="javascript: void(0)"
              pdk-link=""
              routerlink=""
            >
               Upload SJP notices, previous convictions and witness statements 
            </a>
          </div>
          <div
            class="govuk-!-margin-top-6"
            ng-reflect-top="6"
            pdk-margin-top="6"
          >
            <a
              class="govuk-link"
              href="javascript: void(0)"
              pdk-link=""
              routerlink=""
            >
               Check document uploads 
            </a>
          </div>
          <h2
            class="govuk-!-margin-top-8 govuk-heading-m"
            ng-reflect-top="8"
            ng-reflect-type="heading-medium"
            pdk-margin-top="8"
            pdk-typography="heading-medium"
          >
            Other tasks
          </h2>
          <review-not-guilty-pleas-link
            ng-reflect-number-of-cases="1"
          >
            <span>
              1
            </span>
          </review-not-guilty-pleas-link>
          <p
            class="govuk-caption-m"
            ng-reflect-type="caption-medium"
            pdk-typography="caption-medium"
          >
            Defendant details updates (0)
          </p>
          <div>
            <a
              class="govuk-link govuk-section-break govuk-section-break--s"
              href=""
              ng-reflect-type="small"
              pdk-link=""
              pdk-section="small"
            >
              Withdraw an offence
            </a>
          </div>
          <div
            class="govuk-!-margin-top-6"
            ng-reflect-top="6"
            pdk-margin-top="6"
          >
            <a
              class="govuk-link"
              href=""
              pdk-link=""
            >
              Export case results by date
            </a>
          </div>
        </div>
      </pdk-grid>
      <pdk-grid
        ng-reflect-one-third=""
        one-third=""
      >
        <div
          class="govuk-grid-column-one-third"
        >
          <a
            href="javascript: void(0);"
            routerlink="check-csv-uploads"
          >
            <pdk-summary-item

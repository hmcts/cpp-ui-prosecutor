exports[`TflDashboardComponent should compile correctly 1`] = `
<tfl-dashboard
  casesWithSjpNoticeCount={[Function Number]}
  csvUploadErrorCount={[Function Number]}
  documentsUploadErrorCount={[Function Number]}
  pleadedNotGuiltyCasesDetail={[Function Object]}
>
  <pdk-grid>
    <div>
      <h1
        class="govuk-!-margin-top-8 govuk-!-margin-bottom-8 govuk-heading-xl"
        ng-reflect-type="heading-xlarge"
        ng-reflect-vertical="8"
        pdk-margin-vertical="8"
        pdk-typography="heading-xlarge"
      >
        <span
          class="govuk-caption-xl"
          ng-reflect-type="caption-xlarge"
          pdk-typography="caption-xlarge"
        >
          Prosecutor
        </span>
         Single Justice Procedure 
      </h1>
      <h2
        class="govuk-!-margin-top-8 govuk-heading-m"
        ng-reflect-top="8"
        ng-reflect-type="heading-medium"
        pdk-margin-top="8"
        pdk-typography="heading-medium"
      >
        Search for a case
      </h2>
      <search-input-container>
        <div />
      </search-input-container>
    </div>
  </pdk-grid><pdk-grid
    container=""
    ng-reflect-container=""
  >
    <div
      class="govuk-grid-row"
    >
      <pdk-grid
        ng-reflect-two-thirds=""
        two-thirds=""
      >
        <div
          class="govuk-grid-column-two-thirds"
        >
          <h2
            class="govuk-!-margin-top-8 govuk-heading-m"

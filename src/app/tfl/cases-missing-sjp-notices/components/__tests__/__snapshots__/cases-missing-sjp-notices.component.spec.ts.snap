exports[`CasesMissingSjpNoticesComponent should compile correctly with multiple rows 1`] = `
<cases-missing-sjp-notices
  casesMissingNotices={[Function Array]}
>
  <ol
    class="govuk-!-margin-top-4"
    ng-reflect-top="4"
    pdk-breadcrumb-list=""
    pdk-margin-top="4"
  >
    <li
      pdk-breadcrumb-list-item=""
    >
      <a
        href="javascript: void(0)"
        pdk-breadcrumb=""
        routerlink="../../"
      >
        Home
      </a>
    </li>
    <li
      pdk-breadcrumb-list-item=""
    >
       Send missing SJP Notices to court 
    </li>
  </ol><h1
    class="govuk-!-margin-top-6 govuk-!-margin-bottom-6 govuk-heading-xl"
    ng-reflect-type="heading-xlarge"
    ng-reflect-vertical="6"
    pdk-margin-vertical="6"
    pdk-typography="heading-xlarge"
  >
     Send missing SJP Notices to court 
  </h1><p
    class="govuk-heading-m"
    ng-reflect-type="heading-medium"
    pdk-typography="heading-medium"
  >
    <span
      data-test="cases-number"
      ng-reflect-ng-plural="2"
    >
      
      
      
      2 cases
    </span>
     missing notices 
  </p><list-cases-missing-sjp-notices
    ng-reflect-cases-missing-notices="[object Object],[object Object"
  >
    <div>
      [
    {
      "id": "caseId1",
      "urn": "22C22222222",
      "defendant": {
        "id": "defendantId1",
        "title": "Mr",
        "firstName": "Abel",
        "lastName": "Krumps",
        "dateOfBirth": "1972-01-01",
        "gender": "Male",
        "nationalInsuranceNumber": "SR67854OP"
      },
      "prosecutingAuthority": "TFL",
      "postingDate": "2019-05-03"
    },
    {
      "id": "caseId2",
      "urn": "33C2DF22222",
      "defendant": {
        "id": "defendantId2",
        "title": "Mrs",
        "firstName": "Linda",
        "lastName": "Craig",
        "dateOfBirth": "1980-07-12",
        "gender": "Female",
        "nationalInsuranceNumber": "SR63344OQ"
      },
      "prosecutingAuthority": "TFL",
      "postingDate": "2019-05-03"
    }
  ]
    </div>
  </list-cases-missing-sjp-notices><div>
    <p
      class="govuk-!-margin-top-10 govuk-!-margin-bottom-10 govuk-heading-m"
      ng-reflect-type="heading-medium"
      ng-reflect-vertical="10"
      pdk-margin-vertical="10"
      pdk-typography="heading-medium"
    >
       When you've found the missing notices 
    </p>
    <p
      class="govuk-body-m"
      ng-reflect-type="body"
      pdk-typography="body"
    >
       Put the notices in a new zip file and then upload. 
    </p>
    <button
      class="govuk-!-margin-top-5 govuk-!-margin-bottom-5"
      ng-reflect-vertical="5"
      pdk-button=""
      pdk-margin-vertical="5"
      routerlink="../../upload-missing-sjp-notices"
    >
       Go to upload documents 
    </button>
  </div>
</cases-missing-sjp-notices>
`;


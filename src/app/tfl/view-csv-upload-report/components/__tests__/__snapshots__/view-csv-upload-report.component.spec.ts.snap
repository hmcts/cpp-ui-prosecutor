                [
    {
      "csvColumn": "H",
      "csvRow": 1,
      "tflCaseUrn": "TFL88932KI14X",
      "validationMessageKey": "DATE_OF_HEARING_WRONG_FORMAT"
    }
  ]
              </div>
              <div>
                Header error list
              </div>
            </csv-upload-error-list>
          </section>
          
          <section>
            <h3>
               Offences - fix 1 
              <span
                ng-reflect-ng-plural="1"
              >
                
                error
                
              </span>
            </h3>
            <csv-upload-error-list
              ng-reflect-csv-errors="[object Object]"
              ng-reflect-summary="Offences error list"
              summary="Offences error list"
            >
              <div>
                [
    {
      "csvColumn": "H",
      "csvRow": 1,
      "tflCaseUrn": "TFL88932KI14X",
      "validationMessageKey": "DATE_OF_HEARING_WRONG_FORMAT"
    }
  ]

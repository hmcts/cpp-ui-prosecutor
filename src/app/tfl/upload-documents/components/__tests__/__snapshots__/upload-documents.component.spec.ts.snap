exports[`UploadDocumentsComponent should compile correctly 1`] = `
<upload-documents
  uploadDocuments={[Function EventEmitter]}
>
  <ol
    class="govuk-!-margin-top-4 govuk-!-margin-bottom-4"
    ng-reflect-vertical="4"
    pdk-breadcrumb-list=""
    pdk-margin-vertical="4"
  >
    <li
      pdk-breadcrumb-list-item=""
    >
      <a
        href="javascript: void(0)"
        pdk-breadcrumb=""
        routerlink="/tfl"
      >
        Home
      </a>
    </li>
    <li
      pdk-breadcrumb-list-item=""
    >
      <a
        pdk-breadcrumb=""
      >
        Upload SJP notices and other documents
      </a>
    </li>
  </ol><h1
    class="govuk-!-margin-top-4 govuk-!-margin-bottom-4 govuk-heading-xl"
    ng-reflect-type="heading-xlarge"
    ng-reflect-vertical="4"
    pdk-margin-vertical="4"
    pdk-typography="heading-xlarge"
  >
    Upload SJP notices and 
    <br />
    other documents
  </h1><p>
    Put your documents in a zip file and then upload. You can include:
  </p><ul>
    <li>
      SJP notices
    </li>
    <li>
      previous convictions
    </li>
    <li>
      witness statements
    </li>
  </ul><pdk-inset-text>
     If you only want to upload one document, you'll still need to put it in a zip file. 
  </pdk-inset-text><upload-document-form>
    <div>
      Upload document form
    </div>
  </upload-document-form>
</upload-documents>
`;


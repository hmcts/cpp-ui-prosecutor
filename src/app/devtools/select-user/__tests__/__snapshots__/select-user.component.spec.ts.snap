exports[`DevTools - Select User component compiles 1`] = `
<dev-tools-select-user
  form={[Function NgForm]}
  selectUser={[Function EventEmitter_]}
  users={[Function Array]}
>
  <div
    class="govuk-width-container"
    pdk-container=""
    style="display: block;"
  >
    <h1
      class="govuk-!-margin-top-8 govuk-!-margin-bottom-8 govuk-heading-xl"
      pdk-margin-vertical="8"
      pdk-typography="heading-xlarge"
    >
       Developer tools 
    </h1>
    <h3
      class="govuk-heading-m"
      pdk-typography="heading-medium"
    >
      Select a user
    </h3>
    <form
      class="ng-untouched ng-pristine ng-valid"
      novalidate=""
      pdk-form=""
    >
      <pdk-form-field>
        <pdk-form-group
          class="pdk-form-group"
        >
          <pdk-select
            class="ng-untouched ng-pristine ng-valid"
            id="selectUser"
            name="userId"
            placeholder="---Please select---"
            required=""
          >
            <select
              class="govuk-select"
              id="selectUser"
              name="userId"
              required=""
            >
              <option
                value=""
              >
                ---Please select---
              </option>
              <option
                value="userId"
              >
                 Mock User 
              </option>
            </select>
          </pdk-select>
        </pdk-form-group>
      </pdk-form-field>
      <pdk-form-group
        class="pdk-form-group"
      >
        <button
          disabled=""
          pdk-button=""
          type="submit"
        >
           Confirm identity 
        </button>
      </pdk-form-group>
    </form>
  </div>
</dev-tools-select-user>
`;


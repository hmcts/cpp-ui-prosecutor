{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es5",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2018", "es2017", "es2016", "dom"],
    "types": ["node", "jest", "jasmine"],
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
